{
  "name": "truthseeker",
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "description": "First-principles rebuttal generator with full source and author transparency.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "analyze": "tsx scripts/analyze-cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ai-kit": "github:bitbaum/ai-kit#v0.6.2",
    "entities": "^8.0.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "^16.3.3",
    "prettier": "3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
